# Copy this file to backend/.env and fill in your keys.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any Responses-API model you have access to. A small/fast model keeps answers ~1-2s.
OPENAI_MODEL=gpt-5-mini

# Finnhub (free tier): https://finnhub.io/register
FINNHUB_API_KEY=

# auto   = live data, fall back to sample data if live prices are unreachable
# live   = live data only (errors if unreachable)
# sample = synthetic sample data only (works fully offline, for development)
DATA_MODE=auto

CACHE_TTL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=6
