# Copy this file to backend/.env and fill in your keys.

# OpenAI: https://platform.openai.com/api-keys  (add credits under Settings > Billing)
OPENAI_API_KEY=
# Any Responses-API model your account can use. Fast models keep fresh answers to a few seconds.
OPENAI_MODEL=gpt-6-luna
# Reasoning effort for reasoning models: none / low / medium. Lower is faster.
OPENAI_REASONING=none

# Finnhub (free tier): https://finnhub.io/register
# With a key, prices stream trade by trade over Finnhub's WebSocket (milliseconds).
FINNHUB_API_KEY=

# auto   = live data, fall back to sample data if live prices are unreachable
# live   = live data only (errors if unreachable)
# sample = synthetic sample data only (works fully offline, for development)
DATA_MODE=auto

# Keep answers for every listed stock pre-computed in the background,
# so clicking a stock shows its answer instantly.
WARM_WATCHLIST=true

CACHE_TTL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=6
